# Локальная модель Ollama с поддержкой инструментов
AGENT_PROVIDER=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1/
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:4b

# Для OpenRouter удалите настройки Ollama выше и задайте, например:
# AGENT_PROVIDER=openrouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1/
# OPENROUTER_API_KEY=
# OPENAI_MODEL=your-provider/your-tool-capable-model

# Явные параметры модели для воспроизводимых запусков
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_MS=180000
# OPENAI_REASONING_EFFORT=none
# OPENAI_SEED=42
